{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window. Every app command the main window invokes is granted here explicitly: the AppManifest (build.rs) makes Tauri's ACL deny any app command that is not granted to the invoking window. Secret/key, chat, memory, Engram, OAuth and tray commands are main-only (ronda3 S3).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "window-state:default",
    "autostart:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-deeplink-take-pending",
    "allow-google-oauth-start",
    "allow-google-oauth-revoke",
    "allow-google-oauth-cancel",
    "allow-notify-show",
    "allow-desktop-backdrop",
    "allow-quickadd-get-config",
    "allow-quickadd-set-shortcut",
    "allow-idle-seconds",
    "allow-tray-sync",
    "allow-desktop-launched-at-sign-in",
    "allow-desktop-show-main",
    "allow-chat-key-status",
    "allow-chat-key-set",
    "allow-chat-key-clear",
    "allow-chat-stream",
    "allow-chat-cancel",
    "allow-chat-complete",
    "allow-chat-memories-list",
    "allow-chat-memories-apply",
    "allow-chat-memories-delete",
    "allow-chat-memories-clear",
    "allow-engram-settings-get",
    "allow-engram-settings-set",
    "allow-engram-sync-now",
    "allow-engram-status"
  ]
}
