{
  "name": "personal-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test src/domain/model.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dev": "vite",
    "test:emulator": "firebase emulators:exec --project demo-calendar-app --only auth,firestore \"node --experimental-strip-types --test tests/emulator.test.ts\"",
    "emulators": "firebase emulators:start --project demo-calendar-app --only auth,firestore"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "firebase-tools": "15.30.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
