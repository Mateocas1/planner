# ----------------------------
# Local tool state
.atl/

# Local code graph index
.codegraph/

# Local tooling output
*.log

# Never commit credentials
*-adminsdk-*.json
*serviceAccount*.json

# Environment files (never commit secrets); keep the example
.env
.env.*
!.env.example

# tauri-build autogenerates allow-/deny- permission files from the AppManifest
# (build.rs) on every build; they are build output, not source.
app/src-tauri/permissions/autogenerated/
